# Copy to .env and adjust. Every setting is optional; defaults are for a local demo.
FRAUDSHIELD_ENVIRONMENT=local
# Pin a model version instead of the registry's production model:
# FRAUDSHIELD_MODEL_VERSION=xgboost-20261016-201718
FRAUDSHIELD_ARTIFACTS_DIR=artifacts
FRAUDSHIELD_POLICY_PATH=configs/decision_policy.yaml
FRAUDSHIELD_DB_PATH=var/fraudshield.db
# When set, mutating endpoints (score, batch, review, policy, replay) require header X-API-Key.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# FRAUDSHIELD_API_KEY=
FRAUDSHIELD_INFERENCE_TIMEOUT_MS=2000
FRAUDSHIELD_MAX_BATCH_SIZE=500
FRAUDSHIELD_RATE_LIMIT_PER_SECOND=200
FRAUDSHIELD_RATE_LIMIT_BURST=400
FRAUDSHIELD_LOG_LEVEL=INFO
FRAUDSHIELD_LOG_JSON=true
FRAUDSHIELD_ENABLE_DOCS=true
# JSON list of allowed browser origins (dashboard dev server):
FRAUDSHIELD_CORS_ORIGINS=["http://localhost:5173"]
